<Window x:Class="PoseidonClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2008/xaml/display"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoseidonClient"
        mc:Ignorable="d"
        Title="Poseidon — n8n-like Automation (Lua)"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Dark mode palette -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#252526"/>
        <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CD9FE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E"/>
        <SolidColorBrush x:Key="NodeBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="NodeSelectedBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#555555"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#4E4E52"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextElement.FontFamily" Value="Segoe UI"/>
            <Setter Property="TextElement.FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Top toolbar -->
        <DockPanel LastChildFill="True">
            <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <ToolBar Band="0" BandIndex="0" Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <Button Content="New Workflow" Click="NewWorkflow_Click" ToolTip="Create a new workflow"/>
                    <Button Content="Open" Click="OpenWorkflow_Click" ToolTip="Open existing workflow"/>
                    <Button Content="Save" Click="SaveWorkflow_Click" ToolTip="Save workflow to database"/>
                    <Separator/>
                    <Button Content="▶ Execute" Click="ExecuteWorkflow_Click" Background="{StaticResource AccentBrush}" ToolTip="Run the workflow"/>
                    <Button Content="⏹ Stop" Click="StopWorkflow_Click" ToolTip="Stop running workflow"/>
                    <Separator/>
                    <Button Content="Add Node" Click="AddNode_Click" ToolTip="Add a new node to the canvas"/>
                    <Button Content="Delete" Click="DeleteSelected_Click" ToolTip="Delete selected node"/>
                </ToolBar>
                <ToolBar Band="0" BandIndex="1" Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="|" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock x:Name="ConnectionText" Text="Not connected" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0"/>
                </ToolBar>
            </ToolBarTray>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Node palette (left) -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock Text="NODES" DockPanel.Dock="Top" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="Bold" Margin="10,5" FontSize="11" TextTransform="Uppercase"/>
                        <ListBox x:Name="NodePalette" DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PaletteItem_MouseLeftButtonDown"/>
                                    <EventSetter Event="MouseMove" Handler="PaletteItem_MouseMove"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem Content="HTTP Request" Tag="http_request"/>
                            <ListBoxItem Content="MySQL Query" Tag="mysql_query"/>
                            <ListBoxItem Content="Code (Lua)" Tag="code"/>
                            <ListBoxItem Content="If / Branch" Tag="if"/>
                            <ListBoxItem Content="Wait / Sleep" Tag="wait"/>
                            <ListBoxItem Content="AI Chat" Tag="ai"/>
                            <ListBoxItem Content="Mail" Tag="mail"/>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Canvas (center) -->
                <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="WorkflowCanvas" Background="{StaticResource BackgroundBrush}"
                                Width="1600" Height="1200"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                MouseMove="Canvas_MouseMove"
                                AllowDrop="True" Drop="Canvas_Drop"/>
                    </ScrollViewer>
                </Border>

                <!-- Properties / script editor (right) -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock Text="PROPERTIES" DockPanel.Dock="Top" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="Bold" Margin="10,5" FontSize="11" TextTransform="Uppercase"/>
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="140">
                            <StackPanel x:Name="PropertiesPanel" Margin="10"/>
                        </ScrollViewer>
                        <TextBlock Text="LUA SCRIPT" DockPanel.Dock="Top" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="Bold" Margin="10,10,10,5" FontSize="11" TextTransform="Uppercase"/>
                        <TextBox x:Name="ScriptEditor" DockPanel.Dock="Bottom" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="#1E1E1E" Foreground="#D4D4D4"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 Margin="10"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Execution log (bottom) -->
            <Border DockPanel.Dock="Bottom" Height="150" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock Text="EXECUTION LOG" DockPanel.Dock="Top" Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Bold" Margin="10,5" FontSize="11" TextTransform="Uppercase"/>
                    <ListBox x:Name="ExecutionLog" DockPanel.Dock="Bottom" Background="{StaticResource BackgroundBrush}"
                             BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                             FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
