# Poseidon environment configuration
# Copy this file to .env and fill in your own values.
# Load it with:  set -a; . ./.env.example; set +a   (bash/zsh)
# or:            dotnet user-secrets ...             (ASP.NET Core)

# ---------------- MySQL database ----------------
POSEIDON_DB_HOST=localhost
POSEIDON_DB_PORT=3306
POSEIDON_DB_USER=poseidon
POSEIDON_DB_PASSWORD=poseidon
POSEIDON_DB_SCHEMA=poseidon

# ---------------- Cryptography ----------------
# AES-256 master key for encrypting credentials at rest.
# Must decode to exactly 32 bytes (256 bits). Generated below; rotate in production.
POSEIDON_MASTER_KEY=xxVtG7K570j8Zdl2Q6rUOGY71vT8hdFqy+9/lvFUgTc=

# HS256 JWT signing key for auth tokens.
# Must decode to exactly 32 bytes (256 bits). Generated below; rotate in production.
POSEIDON_JWT_KEY=SfTbPCK2101Y6Guok3Wfknn2tuK/SCb+Ym1ENHvtVdQ=

# ---------------- Admin account ----------------
POSEIDON_ADMIN_USER=admin
# PBKDF2-HMAC-SHA256 hash (210k iterations, 16-byte salt) for password "changeme".
# Regenerate with a strong password before production use.
POSEIDON_ADMIN_PASSWORD_HASH=$pbkdf2v1$210000$uxPoHVojRcGrZrihZP2foQ==$IlX3bD3seNTHDdEKhSXhrT4GhNQz9n6aFvCo8kHXQZQ=

# ---------------- AI (optional) ----------------
# Set POSEIDON_AI_API_KEY to enable the ai.chat() Lua function.
# Without it, ai.chat() returns a deterministic stub response.
POSEIDON_AI_API_KEY=
POSEIDON_AI_URL=https://api.openai.com/v1/chat/completions

# ---------------- Server ----------------
# URLs the Kestrel server listens on. Use https:// in production with a cert.
ASPNETCORE_URLS=http://localhost:7071
